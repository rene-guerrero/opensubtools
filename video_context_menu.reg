Windows Registry Editor Version 5.00

[HKEY_CLASSES_ROOT\SystemFileAssociations\.mp4\shell\Generate Subtitles]
@="Generate Subtitles"

[HKEY_CLASSES_ROOT\SystemFileAssociations\.mp4\shell\Generate Subtitles\command]
@="cmd /k \"\"D:\\Me\\for-pleasure\\subtitles\\venv\\Scripts\\python.exe\" -m subtitles.cli.generate \"%1\"\"\""

